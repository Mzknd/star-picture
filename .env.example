# Copy to /etc/star-picture/star-picture.env for the systemd example.
# Spring Boot does not automatically load this file. Never commit real secrets.
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/star_pic?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia%2FShanghai
DB_USERNAME=starpic
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
COS_HOST=https://your-bucket-1250000000.cos.ap-shanghai.myqcloud.com
COS_REGION=ap-shanghai
COS_BUCKET=your-bucket-1250000000
COS_SECRET_ID=
COS_SECRET_KEY=
# Exact frontend origins, comma-separated, no wildcard, path or trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Exact trusted image-source/AI-result hosts, comma-separated; replace the example before deployment.
PICTURE_UPLOAD_ALLOWED_HOSTS=images.example.com
PICTURE_UPLOAD_REQUIRE_ALLOWLIST=true
# Optional: required only for the administrator /user/add endpoint; 8+ chars, <=72 UTF-8 bytes.
INITIAL_USER_PASSWORD=
# Set true only when the browser accesses the API over HTTPS.
SERVER_SERVLET_SESSION_COOKIE_HTTP_ONLY=true
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=lax
SPRING_SESSION_REDIS_NAMESPACE=star-picture:session
# AI is disabled until real service validation is complete.
AI_OUT_PAINTING_ENABLED=false
# Empty: only administrators may create paid tasks. Add explicit demo user IDs, comma-separated.
AI_OUT_PAINTING_ALLOWED_USER_IDS=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
AI_OUT_PAINTING_DAILY_LIMIT=5
AI_OUT_PAINTING_ACTIVE_LIMIT=2
AI_OUT_PAINTING_POLL_INTERVAL_SECONDS=5